{
  "name": "@poweur/client",
  "version": "0.2.0",
  "description": "Poweur protocol client — identity, messaging, contacts, system files and proof-of-work for browser, Node, Bun and Deno.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "poweur": "./dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./crypto": "./dist/crypto/index.js",
    "./drive": "./dist/drive/index.js",
    "./canonical": "./dist/canonical.js",
    "./resolve": "./dist/resolve.js",
    "./identity": "./dist/identity.js",
    "./messages": "./dist/messages.js",
    "./contacts": "./dist/contacts.js",
    "./policy": "./dist/policy.js",
    "./keystore": "./dist/keystore.js",
    "./kit": "./dist/kit.js",
    "./enroll": "./dist/enroll.js",
    "./pow": "./dist/pow.js",
    "./node": "./dist/node/index.js",
    "./browser": "./dist/browser/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@noble/ciphers": "^1.1.3",
    "@noble/curves": "^1.7.0",
    "@noble/hashes": "^1.6.1",
    "@scure/bip39": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "poweur",
    "identity",
    "ed25519",
    "e2ee",
    "messaging"
  ],
  "publishConfig": {
    "access": "public"
  }
}
