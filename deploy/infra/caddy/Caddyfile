    }
}

# RFC 9116 security contact for the hosted service, on the hosts people report
# against (poweur.org serves the same file from apps/site/.well-known). Renew
# Expires with the site's copy. Only the service's own names answer it, so an
# identity host (alice.poweur.net) still gets its own pages.
(security_txt) {
    @security_txt {
        path /.well-known/security.txt
        host poweur.net relay.poweur.net oauth.poweur.org
    }
    handle @security_txt {
        header Content-Type "text/plain; charset=utf-8"
        respond `# Security contact for Poweur: the hosted service at poweur.net and
# oauth.poweur.org, the poweur.org website, and the open-source code at
# https://github.com/romanmandryk/poweur
Contact: mailto:info@poweur.org
Expires: 2027-09-24T00:00:00.000Z
Preferred-Languages: en
Canonical: https://{http.request.host}/.well-known/security.txt
Policy: https://poweur.org/legal/#security
` 200
    }
}

# Browser telemetry (Grafana Faro, apps/*, packages/faro): each site posts to
# /faro/collect on its own origin and this hands it to Alloy's faro.receiver,
# without the client's IP. Imported by every site that sends it.
(faro) {
    # CORS for the mobile shell only (capacitor://localhost on iOS,
    # https://localhost on Android); every web page posts same-origin. Caddy
    # answers it because Faro sends an Idempotency-Key header that Alloy's
    # receiver does not allow in a preflight.
    @faro_cors {
        path /faro/collect
        header_regexp Origin ^(capacitor://localhost|https://localhost)$
    }
    header @faro_cors {
        Access-Control-Allow-Origin {http.request.header.Origin}
        Access-Control-Allow-Methods "POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Idempotency-Key, X-Faro-Session-Id"
        Access-Control-Max-Age 86400
        Vary Origin
    }
    @faro_preflight {
        method OPTIONS
        path /faro/collect
    }
    handle @faro_preflight {
        respond 204
    }
    @faro {
        method POST
        path /faro/collect
    }
    handle @faro {
        request_body {
            max_size 256KB
        }
        uri strip_prefix /faro
        reverse_proxy infra-alloy:12347 {
            header_up -X-Forwarded-For
            header_up -X-Real-IP
            header_up -CF-Connecting-IP
            header_up -CF-IPCountry
        }
    }
}

# HTTPS for remote exporters; the same-VM relay talks directly to Alloy.
# Alloy authenticates both paths. No request/access log is enabled here.
ingest.poweur.net {
    @otlp {
        method POST
        path /v1/logs /v1/metrics
    }
    handle @otlp {
        request_body {
            max_size 2MB
        }
        reverse_proxy infra-alloy:4318
    }
    handle {
        respond "Not found" 404
    }
}

http://relay.poweur.net {
    import security_txt
    reverse_proxy poweur-relay:8080 {
        header_up X-Forwarded-For {client_ip}
    }
}
# HTTP as well as HTTPS: Cloudflare currently delivers identity hosts (and
# this name, via the wildcard) to origin over HTTP. HTTPS-only grafana would
# miss those requests and http://*.poweur.net would send them to the relay.
http://grafana.poweur.net grafana.poweur.net {
    reverse_proxy infra-grafana:3000
}
# The OAuth/OIDC bridge (EPIC-022; apps/oauth/deploy). HTTP as well as HTTPS
# for the same reason as grafana: Cloudflare may deliver to origin over HTTP.
http://oauth.poweur.org oauth.poweur.org {
    import faro
    import security_txt
    handle {
        reverse_proxy poweur-oauth:8090 {
            header_up X-Forwarded-For {client_ip}
        }
    }
}
# poweur.org website (apps/site) with the docs (apps/docs, Docusaurus) under /docs,
# static files published by .github/workflows/deploy-web.yml into
# /opt/apps/poweur-web/www. A temporary host while the site is new, so it asks
# search engines not to index it. HTTP as well as HTTPS for the same reason as
# grafana and oauth.
http://tmpwww.poweur.org tmpwww.poweur.org {
    import faro
    root * /srv/web/www
    encode zstd gzip
    header {
        X-Robots-Tag "noindex, nofollow"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    header /assets/* Cache-Control "public, max-age=3600"
    # Docusaurus fingerprints its bundles.
    header /docs/assets/* Cache-Control "public, max-age=31536000, immutable"
    redir /docs /docs/ 308
    # Docusaurus writes /docs/page/index.html; the site has /architecture.html.
    try_files {path} {path}/index.html {path}.html
    file_server
    handle_errors 404 {
        @docs path /docs/*
        handle @docs {
            rewrite * /docs/404.html
            file_server
        }
        handle {
            redir * / 302
        }
    }
}
# guestbook.poweur.net (apps/demoapps/guestbook) is a Poweur ID hosted on the relay AND a web
# app. Like every hosted identity, its host also answers the relay API (messages, sessions,
# events, drive, /pub, the identity documents): senders reach a hosted ID's relay through its own
# host. So the relay keeps everything and the app takes only the paths it serves itself.
# HTTP as well as HTTPS for the same reason as grafana and oauth.
http://guestbook.poweur.net guestbook.poweur.net {
    @app {
        path / /healthz /assets/* /api/session /api/entries
        path /auth/start /auth/callback /auth/resume /auth/poll /auth/context /auth/r/* /auth/logout
        path /.well-known/poweur.json
    }
    handle @app {
        reverse_proxy poweur-guestbook:8080 {
            header_up X-Forwarded-For {client_ip}
        }
    }
    handle {
        reverse_proxy poweur-relay:8080 {
            header_up X-Forwarded-For {client_ip}
        }
    }
}
http://poweur.net http://*.poweur.net {
    import faro
    import security_txt
    handle {
        reverse_proxy poweur-relay:8080 {
            header_up X-Forwarded-For {client_ip}
        }
    }
}
