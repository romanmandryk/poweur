{
    # Cloudflare must use Full (strict), not Flexible. Caddy obtains origin
    # certificates for these fixed infrastructure hosts; identity wildcard
    # traffic retains the existing Cloudflare HTTP-origin path.
    email admin@poweur.net
}

# Accept HTTP internally for the same-VM relay, and HTTPS for remote exporters.
# Alloy authenticates both paths. No request/access log is enabled here.
ingest.poweur.net, http://ingest.poweur.net {
    @otlp {
        method POST
        path /v1/logs /v1/metrics
    }
    handle @otlp {
        request_body {
            max_size 2MB
        }
        reverse_proxy infra-alloy:4318
    }
    handle {
        respond "Not found" 404
    }
}

http://relay.poweur.net {
    reverse_proxy poweur-relay:8080
}
http://grafana.poweur.net {
    reverse_proxy infra-grafana:3000
}
http://poweur.net http://*.poweur.net {
    reverse_proxy poweur-relay:8080
}
