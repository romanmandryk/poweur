# HTTPS for remote exporters; the same-VM relay talks directly to Alloy.
# Alloy authenticates both paths. No request/access log is enabled here.
ingest.poweur.net {
    @otlp {
        method POST
        path /v1/logs /v1/metrics
    }
    handle @otlp {
        request_body {
            max_size 2MB
        }
        reverse_proxy infra-alloy:4318
    }
    handle {
        respond "Not found" 404
    }
}

http://relay.poweur.net {
    reverse_proxy poweur-relay:8080 {
        header_up X-Forwarded-For {client_ip}
    }
}
grafana.poweur.net {
    reverse_proxy infra-grafana:3000
}
http://poweur.net http://*.poweur.net {
    reverse_proxy poweur-relay:8080 {
        header_up X-Forwarded-For {client_ip}
    }
}
