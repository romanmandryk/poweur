      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(count_over_time({source=\"faro\", app=~\"$app\", kind=\"exception\"} [$__range])) / sum(count_over_time({source=\"faro\", app=~\"$app\", kind=\"event\"} | logfmt | event_name=\"page_view\" [$__range]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
