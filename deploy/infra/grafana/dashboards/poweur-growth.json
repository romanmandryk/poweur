  "uid": "poweur-growth",
  "title": "Poweur Growth",
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "## ⚡ Poweur, built in public\nLive aggregates from the poweur.net relay, refreshed hourly. We count **identities** (one person may own several), **accepted messages** (end-to-end encrypted, so we only see the envelope type), and **settings choices** as totals. No names, no content, no per-person data."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Identities",
      "description": "Hosted identities on this relay. Identities, not people.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "poweur_growth_hosted_identities",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
