# /etc/poweur-backup/backup.env — written by deploy/ansible from secrets.yml.
# Read by deploy/backup/poweur-backup.sh.

# The Storage Box, through the ssh config in /etc/poweur-backup/ssh/config
# (Host storagebox, port 23). One directory per stack.
RESTIC_REPOSITORY=sftp:storagebox:poweur-restic

# Deleted data leaves the backups after this long; the privacy policy must match.
KEEP_WITHIN=30d

# Optional: a heartbeat URL that alerts when a night is missed or fails
# (Better Stack Heartbeat, healthchecks.io, …). "/fail" is appended on failure.
BACKUP_HEARTBEAT_URL=

# Defaults, change only if the stack changes:
# RESTIC_IMAGE=restic/restic:0.18.0
# BACKUP_VOLUMES="poweur_poweur_data:relay infra_caddy_data:caddy infra_grafana_data:grafana"
# OAUTH_CONTAINER=poweur-oauth
# OAUTH_VOLUME=poweur_oauth_data
# POSTGRES_CONTAINER=infra-postgres
# BACKUP_FILES="/opt/apps/poweur/apps/api/.env.prod /opt/apps/poweur/.observability.env /opt/infra/.env /opt/apps/poweur-oauth/.env.prod"
