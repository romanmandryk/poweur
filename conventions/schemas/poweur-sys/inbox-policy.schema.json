{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poweur.net/schemas/poweur-sys/inbox-policy.schema.json",
  "title": "inbox-policy.json - poweur-sys/relay/inbox-policy.json (owner + relay)",
  "type": "object",
  "required": [
    "mode"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "open",
        "contacts_only",
        "contacts_and_requests"
      ]
    },
    "anonymous": {
      "type": "object",
      "description": "opt-in for unsigned (anonymous) senders (EPIC-014); absent = deny",
      "properties": {
        "allow": {
          "type": "boolean"
        },
        "challenge": {
          "enum": [
            "none",
            "pow",
            "verified",
            "payment"
          ]
        },
        "pow_bits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "max_per_day": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "allow"
      ],
      "additionalProperties": false
    },
    "read_receipts": {
      "type": "object",
      "description": "third-tick receipt policy; absent means enabled",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "disabled_for": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "hostname"
          }
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "trusted_auth_services": {
      "type": "array",
      "description": "Poweur IDs of OAuth bridges that may deliver sys.auth.request (EPIC-022)",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "hostname"
      }
    },
    "email": {
      "type": "object",
      "description": "the email bridge whose email.* messages are admitted in every mode (EPIC-023, PCP-0010); absent = the relay operator's bridge (email on by default), allow=false = opted out",
      "properties": {
        "allow": {
          "type": "boolean"
        },
        "bridge": {
          "type": "string",
          "format": "hostname"
        }
      },
      "required": [
        "allow"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
