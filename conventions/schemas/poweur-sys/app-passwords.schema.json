{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poweur.net/schemas/poweur-sys/app-passwords.schema.json",
  "title": "app-passwords.json - poweur-sys/relay/app-passwords.json (owner + relay)",
  "type": "object",
  "required": [
    "passwords"
  ],
  "properties": {
    "passwords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "hash"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "hash": {
            "type": "string",
            "pattern": "^\\$argon2id\\$"
          },
          "scope": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "device_id": {
            "type": "string",
            "pattern": "^dev_[a-z2-7]{16}$",
            "description": "optional link to a devices.json row (EPIC-004 E04-T6); revoking that device deletes this entry"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
