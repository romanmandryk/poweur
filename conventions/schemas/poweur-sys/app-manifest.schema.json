{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poweur.net/schemas/poweur-sys/app-manifest.schema.json",
  "title": "manifest.json \u2014 /apps/<app-id>/manifest.json (app self-description)",
  "type": "object",
  "required": [
    "app_id",
    "name"
  ],
  "properties": {
    "app_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$",
      "description": "reverse-DNS vendor id; must equal the /apps/<app-id> directory name"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "vendor": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "docs_url": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
