# Relay image only needs the Go modules the Dockerfile copies, plus the
# workspace pieces that build the web client (`@poweur/client` + apps/web).
*
!packages/identity/**
!apps/api/**
!apps/cli/**
!apps/demoapps/**
!package.json
!pnpm-workspace.yaml
!pnpm-lock.yaml
!packages/client-ts/**
!packages/faro/**
!apps/web/**
**/node_modules
**/dist
**/test-results

# Never send local environment secrets to the image builder.
**/.env
**/.env.*
